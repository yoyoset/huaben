# 复制为 .env(不进 git)。密钥只放这里。
HUABEN_OPENROUTER_API_KEY=
# HUABEN_LLM_MODEL=deepseek/deepseek-v4.1-flash
# 单次模型调用的总时长上限(秒,含重试)。上游发保活字节时 httpx 的超时永不触发,靠这个兜底
# HUABEN_LLM_CALL_DEADLINE_S=600
# HUABEN_DATA_DIR=./data
# HUABEN_BUFFER_CHAPTERS=3
# 部署相关(docker compose 读取)
# HUABEN_HOST_PORT=8210
# HUABEN_BACKUP_DIR=/mnt/4t/backups/huaben
# 花费只提醒、不拦(默认):过去 24 小时超过这个数就在书架上提醒
# HUABEN_SPEND_REMIND_USD_24H=2
# 可选硬上限:超过即停止调用模型;0 = 不设(默认)
# HUABEN_SPEND_LIMIT_USD_24H=0
# 配音:pc(默认,电脑上的配音程序来取任务)/ edge(服务器自动用 edge-tts)
# HUABEN_TTS_MODE=pc
# HUABEN_VOICE_WORKER_TOKEN=
